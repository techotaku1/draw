{
  "name": "next-js-boilerplate",
  "author": "Ixartz (https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "next dev",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server -m 100 --db=local.db --run \"npm run db:migrate\"",
    "db-server:memory": "pglite-server -m 100 --run \"npm run db:migrate\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "1.15.0",
    "@clerk/localizations": "^4.24.3",
    "@clerk/nextjs": "^7.9.22",
    "@google/genai": "2.31.0",
    "@logtape/logtape": "2.4.2",
    "@sentry/nextjs": "10.78.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "translation-resilience": "0.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "1.0.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/prompt-cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@electric-sql/pglite-socket": "0.2.16",
    "@faker-js/faker": "10.6.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.64.1",
    "@spotlightjs/spotlight": "4.12.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv-cli": "11.1.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "hono": "4.12.31",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.0": true,
    "lefthook@2.1.14": true,
    "@parcel/watcher@2.6.0": true,
    "@sentry/cli@2.58.6": true,
    "protobufjs@7.6.6": true
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
